# Copy this file to .env and fill in real values. Never commit .env to git.

# MongoDB Atlas connection string (free tier)
# If your database user's password has special characters (@ # % : / etc.),
# URL-encode them or the connection string will fail to parse.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/feed-sioux-falls

# Long random string used to sign JWT tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session lasts before a volunteer needs to re-enter their PIN
JWT_EXPIRES_IN=30d

# Stripe secret key (starts with sk_live_ or sk_test_) - from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret - from Stripe Dashboard > Developers > Webhooks
# (created after you add the webhook endpoint - see backend/README.md)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Comma-separated list of origins allowed to call this API.
# Add your future public web app's domain here when it exists.
ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.1:8081

PORT=4000
NODE_ENV=development
