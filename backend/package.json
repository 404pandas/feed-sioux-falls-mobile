{
  "name": "feed-sioux-falls-backend",
  "version": "1.0.0",
  "description": "Self-hosted backend for the Feed Sioux Falls outreach app",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/utils/seed.js",
    "test": "node --test test/api.test.js",
    "import:headcounts": "node src/utils/importHeadcounts.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.5.1",
    "stripe": "16.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
