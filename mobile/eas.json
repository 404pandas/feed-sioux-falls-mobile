{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "node": "20.19.4",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "API_URL": "https://feed-sioux-falls-mobile.onrender.com"
      },
      "autoIncrement": true,
      "channel": "production"
    },
    "production": {
      "node": "20.19.4",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "API_URL": "https://feed-sioux-falls-mobile.onrender.com"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
