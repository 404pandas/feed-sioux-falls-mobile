# Copy this file to .env and fill in your real Stripe publishable key.
# Never commit .env to git. Publishable keys are safe to expose client-side
# (that's what they're for), but keep this file out of git anyway so nobody
# has to guess which key is actually live vs test.

# Stripe publishable key (starts with pk_test_ or pk_live_) - from Stripe
# Dashboard > Developers > API keys. This is read by app.config.js at
# `expo start` time, not by the app's JS bundle directly.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Only needed if the backend isn't reachable at http://localhost:4000 -
# see backend/README.md's notes on iOS Simulator vs Android emulator vs a
# physical device for what this should be.
API_URL=http://localhost:4000
